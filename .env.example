# Copy to .env and adjust. All values are optional.

# Gated Hugging Face models (Llama, etc.) need a token.
HF_TOKEN=

# Where the Docker host keeps the model cache. Default is a named Docker volume.
# To reuse an existing Hugging Face cache on Windows, point at it (forward slashes):
# HF_CACHE_SOURCE=C:/Users/you/.cache/huggingface
HF_CACHE_SOURCE=vllm-hub-hf-cache

# vLLM image and the host port for its OpenAI-compatible API.
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_PORT=8000
